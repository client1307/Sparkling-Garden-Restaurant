# Use an authenticated MongoDB deployment; localhost is not a production default.
MONGO_URI=
# Generate a random value of at least 32 characters.
JWT_SECRET=
PORT=5000
# Comma-separated list of allowed frontend origins (also used in table QR codes)
FRONTEND_URL=http://localhost:5173
TRUST_PROXY=1
GEMINI_API_KEY=
# Required: unique staff passwords used by the seed script
SEED_ADMIN_PASSWORD=
SEED_CHEF_PASSWORD=
SEED_WAITER_PASSWORD=

# Staff routes (/api/pos) only accept these public IPs (restaurant network). Empty = allow all (dev only)
STAFF_ALLOWED_IPS=
# Generate a random value of at least 32 characters for the print agent.
PRINT_AGENT_KEY=
SEED_BILLING_PASSWORD=
